# Environment Configuration for Limitless Infotech Solution
# Copy this file to .env and update with your specific values

# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# Database Configuration (Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Third-party API Keys
VITE_GOOGLE_API_KEY=your-google-api-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_CHATBOT_API_KEY=your-chatbot-api-key

# Feature Flags
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_SANDBOX=true

# Subdomain Configuration
VITE_MAIN_DOMAIN=limitlessinfotech.com
VITE_SUBDOMAIN_PRODUCT=product.limitlessinfotech.com
VITE_SUBDOMAIN_SERVICES=services.limitlessinfotech.com
VITE_SUBDOMAIN_ENTERPRISES=enterprises.limitlessinfotech.com
VITE_SUBDOMAIN_ABOUT=about.limitlessinfotech.com

# Contact Information
VITE_CONTACT_EMAIL=info@limitlessinfotech.com
VITE_CONTACT_PHONE=+1-234-567-8900
VITE_CONTACT_ADDRESS="123 Innovation Street, Tech City, TC 12345"

# Development Settings
VITE_DEBUG_MODE=false
VITE_MOCK_DATA_ENABLED=false

# Security Settings
VITE_ENCRYPTION_KEY=your-encryption-key-here
VITE_CSRF_PROTECTION=true

# Internationalization
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,hi,ar,es
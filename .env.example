# Environment Configuration for Limitless Infotech Solution
# Copy this file to .env and update with your specific values

# API Configuration
VITE_API_URL=https://api.limitlessinfotech.com
VITE_API_TIMEOUT=30000

# Database Configuration (Supabase)
VITE_SUPABASE_URL=https://limitlessinfotech.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Third-party API Keys
VITE_GOOGLE_API_KEY=your-google-api-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_ANALYTICS_ID=G-62Q7B46GS6
VITE_CHATBOT_API_KEY=your-chatbot-api-key

# Feature Flags
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_SANDBOX=true

# Subdomain Configuration
VITE_MAIN_DOMAIN=https://limitlessinfotech.com
VITE_SUBDOMAIN_PRODUCT=https://product.limitlessinfotech.com
VITE_SUBDOMAIN_SERVICES=https://services.limitlessinfotech.com
VITE_SUBDOMAIN_ENTERPRISES=https://enterprises.limitlessinfotech.com
VITE_SUBDOMAIN_ABOUT=https://about.limitlessinfotech.com
VITE_SUBDOMAIN_CONTACT=https://contact.limitlessinfotech.com
VITE_SUBDOMAIN_BLOG=https://blog.limitlessinfotech.com
VITE_SUBDOMAIN_PORTFOLIO=https://portfolio.limitlessinfotech.com
VITE_SUBDOMAIN_FAQ=https://faq.limitlessinfotech.com
VITE_SUBDOMAIN_PRICING=https://pricing.limitlessinfotech.com
VITE_SUBDOMAIN_TECHNOLOGY=https://technology.limitlessinfotech.com
VITE_SUBDOMAIN_CAREERS=https://careers.limitlessinfotech.com
VITE_SUBDOMAIN_NEWS=https://news.limitlessinfotech.com
VITE_SUBDOMAIN_TECHNICAL=https://technical.limitlessinfotech.com
VITE_SUBDOMAIN_INVESTORS=https://investors.limitlessinfotech.com

# Contact Information
VITE_CONTACT_EMAIL=info@limitlessinfotech.com,
    support@limitlessinfotech.com,
    sales@limitlessinfotech.com,
    careers@limitlessinfotech.com,
    inquiries@limitlessinfotech.com,
    no-reply@limitlessinfotech.com,
    reports@limitlessinfotech.com,
    contact@limitlessinfotech.com,
    business@limitlessinfotech.com,
VITE_CONTACT_PHONE="+91-7710909492, +91-9326759833"
VITE_CONTACT_ADDRESS="Vashi, Navi Mumbai, Maharashtra 400703, India"
VITE_CONTACT_MAP_URL="https://www.google.com/maps/embed/v1/view?key=your-google-maps-api-key&center=19.076090,72.877420&zoom=15"


# Development Settings
VITE_DEBUG_MODE=false
VITE_MOCK_DATA_ENABLED=false

# Security Settings
VITE_ENCRYPTION_KEY=your-encryption-key-here
VITE_CSRF_PROTECTION=true

# Internationalization
VITE_DEFAULT_LOCALE=device-language
VITE_SUPPORTED_LOCALES=device-language,en,hi,ar,es
